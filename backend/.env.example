# ===== ETDV Backend =====

# Port de l'API (le frontend appelle http://localhost:4000/api par défaut)
PORT=4000

# ==== Base de données Postgres ====
# En local (développement) :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/etdv?schema=public"
#
# En production : chaîne de connexion Neon (gratuit à vie)
# https://neon.tech → Console → Projects → votre projet → Connect → connection string
# DATABASE_URL="postgresql://neondb_owner:XXXX@ep-XXXX.region.aws.neon.tech/neondb?sslmode=require"

# ==== Sécurité ====
# Clé secrète JWT (générez-en une : openssl rand -hex 32)
JWT_SECRET=change-me-in-production
# Expirations (en secondes)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ==== CORS ====
# URL du frontend (développement Vite = 5173, production = votre domaine)
FRONTEND_URL=http://localhost:5173

# ==== Email OTP (optionnel) ====
# Si SMTP_* est renseigné, le code OTP est envoyé par email.
# Sinon (développement), le code est affiché dans les logs du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ETDV <no-reply@etdv.tg>"

# ==== Uploads ====
# Dossier local des fichiers uploadés (médias, avatars)
UPLOAD_DIR=uploads